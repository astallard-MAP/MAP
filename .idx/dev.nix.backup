{ pkgs, ... }: {
  channel = "stable-24.11";
  packages = [ pkgs.nodejs_20 ];
  idx.extensions = [
    "esbenp.prettier-vscode"
    "dbaeumer.vscode-eslint"
    "bradlc.vscode-tailwindcss"
    "google.gemini-vscode"
  ];
  idx.previews = {
    enable = true;
    previews = {
      web = {
        command = ["npm", "run", "dev", "--", "--port", "$PORT", "--hostname", "0.0.0.0"];
        manager = "web";
      };
    };
  };
}
